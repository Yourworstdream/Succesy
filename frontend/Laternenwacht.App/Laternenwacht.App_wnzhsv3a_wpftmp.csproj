  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <!--
    FRONTEND – WPF-Oberfläche: Fokusleiste, Hauptfenster, Rabenbote, Gestaltung, ViewModels.
    Die gesamte Fachlogik liegt im Backend (backend/src): Laternenwacht.Core und Laternenwacht.Platform.Windows.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Laternenwacht.App</RootNamespace>
    <ApplicationIcon>Assets\laterne.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Für quellgenerierte P/Invokes (LibraryImport) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Erlaubt das Bauen (nicht Ausführen) auch auf CI-Systemen ohne Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <AssemblyTitle>Laternenwacht – Fokuswächter</AssemblyTitle>
    <Description>Zeigt am oberen Bildschirmrand, wie lange du dich während der Fokuszeit ablenkst.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <!--
      Laufzeit auf Sparsamkeit eingestellt (die Anwendung ruht fast immer und misst nur einmal pro Sekunde):
      - Keine nebenläufige Speicherbereinigung: spart den Hintergrund-Thread samt Reserve; bei einem Heap
        von wenigen MB dauert ein blockierender Lauf nur Millisekunden.
      - Keine dynamische Profilierung (Tiered PGO): Rechenleistung ist hier nicht gefragt; ohne Instrumentierung
        muss der JIT-Compiler heiße Methoden nur einmal statt zweimal neu übersetzen.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Szenenbilder der Reise (eigene Zeichnungen, 960×1200; Quellen als SVG in docs/szenen) -->
    <!-- Schriften Cinzel, Cinzel Decorative und EB Garamond (SIL Open Font License, Lizenztexte daneben) -->
  </ItemGroup>
  <ItemGroup>
    <!-- Eingebaute Memes: jede Bilddatei in Assets\Memes wird automatisch eingebettet -->
    <EmbeddedResource Include="Assets\Memes\*.jpg;Assets\Memes\*.jpeg;Assets\Memes\*.png;Assets\Memes\*.bmp;Assets\Memes\*.gif" LogicalName="Memes/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF-Projekte importieren System.IO nicht implizit (Namenskonflikte mit System.Windows.Shapes.Path) -->
    <Using Include="System.IO" />
  </ItemGroup>
