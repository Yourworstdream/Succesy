<?xml version="1.0" encoding="utf-8"?>
<!--
  Veröffentlichungsprofil: eine einzelne, eigenständige Laternenwacht.exe für 64-Bit-Windows
  (bringt die .NET-Laufzeit mit, läuft also auf jedem Windows ohne weitere Installation).
  In Visual Studio 2026: Rechtsklick auf "Laternenwacht.App" > Veröffentlichen > dieses Profil wählen.
  Kommandozeile: dotnet publish frontend/Laternenwacht.App -p:PublishProfile=Win-x64-EinzelneExe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      Komprimiert: ~65 MB statt ~145 MB. Kostet beim Start einmalig das Entpacken.
      Deutlich sparsamer (Festplatte und Arbeitsspeicher): das Profil "Win-x64-Schlank", ~1,3 MB.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Vorübersetzt: Beim Start muss kaum noch etwas just-in-time kompiliert werden -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF unterstützt kein Trimming -->
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
