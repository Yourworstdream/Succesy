<!--
  Zustandssymbol: eine Flamme, solange das Licht brennt – eine Schneeflocke, sobald der Frost kommt.
  Bewusst ohne Dauerflackern: Die Fokusleiste ist ständig im Blickfeld. Bewegung im Augenwinkel lenkt ab,
  und jedes Bild würde das transparente Leistenfenster neu zeichnen lassen.
-->
<UserControl x:Class="Laternenwacht.App.Views.LanternGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.Name="Zustand">
  <Viewbox Stretch="Uniform">
    <Grid Width="24" Height="24">
      <Path x:Name="Flame" Data="{StaticResource FlameGeometry}" Fill="{StaticResource GoldBrush}">
        <Path.Style>
          <Style TargetType="Path">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLit, ElementName=Root}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>
      <Path Data="{StaticResource SnowflakeGeometry}" Stroke="{StaticResource FrostBrush}" StrokeThickness="2"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="1">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLit, ElementName=Root}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>
    </Grid>
  </Viewbox>
</UserControl>
