<!--
  Der Laternenpfahl im Schneewald. Brennt die Laterne (IsLit), flackert ein warmes Licht;
  erlischt sie, überzieht Frost das Glas.
-->
<UserControl x:Class="Laternenwacht.App.Views.LanternGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.Name="Laterne">
  <UserControl.Resources>
    <RadialGradientBrush x:Key="HaloBrush">
      <GradientStop Color="#CCFFD27A" Offset="0" />
      <GradientStop Color="#55E8B84A" Offset="0.45" />
      <GradientStop Color="#00E8B84A" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="LitGlassBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFF3C7" Offset="0" />
      <GradientStop Color="#FFD27A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FrostGlassBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#DDEAF6FB" Offset="0" />
      <GradientStop Color="#99A9D6E5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="IronBrush" Color="#2A3140" />

    <Storyboard x:Key="Flicker" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" From="0.75" To="1" Duration="0:0:1.7">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="FlameScale" Storyboard.TargetProperty="ScaleY" From="0.92" To="1.08" Duration="0:0:0.9">
        <DoubleAnimation.EasingFunction>
          <SineEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform">
    <Canvas Width="64" Height="80">
      <!-- Lichtschein -->
      <Ellipse x:Name="Halo" Canvas.Left="2" Canvas.Top="2" Width="60" Height="60" Fill="{StaticResource HaloBrush}" />

      <!-- Ring und Dach -->
      <Ellipse Canvas.Left="29" Canvas.Top="6" Width="6" Height="6" Stroke="{StaticResource IronBrush}" StrokeThickness="1.6" />
      <Path Data="M32,11 L46,21 L18,21 Z" Fill="{StaticResource IronBrush}" />
      <Path Data="M32,10 L41,16.5 L23,16.5 Z" Fill="#EEF5FA" />

      <!-- Glas -->
      <Rectangle x:Name="Glass" Canvas.Left="21" Canvas.Top="21" Width="22" Height="23" Stroke="{StaticResource IronBrush}" StrokeThickness="2">
        <Rectangle.Style>
          <Style TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource LitGlassBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLit, ElementName=Root}" Value="False">
                <Setter Property="Fill" Value="{StaticResource FrostGlassBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Rectangle.Style>
      </Rectangle>
      <Line X1="32" Y1="21" X2="32" Y2="44" Stroke="{StaticResource IronBrush}" StrokeThickness="1.4" />

      <!-- Flamme -->
      <Path x:Name="Flame" Data="M32,25 C35,30 36,33 36,36 C36,38.5 34.2,40 32,40 C29.8,40 28,38.5 28,36 C28,33 29,30 32,25 Z"
            Fill="#FFF8DC" RenderTransformOrigin="0.5,1">
        <Path.RenderTransform>
          <ScaleTransform x:Name="FlameScale" />
        </Path.RenderTransform>
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLit, ElementName=Root}" Value="False">
                <Setter Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Eiskristalle auf dem Glas, wenn die Laterne erlischt -->
      <Path Data="M26,26 L30,30 M30,26 L26,30 M36,34 L40,38 M40,34 L36,38 M28,39 L30,41" Stroke="White" StrokeThickness="0.9">
        <Path.Style>
          <Style TargetType="Path">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsLit, ElementName=Root}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Path.Style>
      </Path>

      <!-- Sockel, Pfahl, Schnee -->
      <Path Data="M19,44 L45,44 L40,49 L24,49 Z" Fill="{StaticResource IronBrush}" />
      <Rectangle Canvas.Left="30" Canvas.Top="49" Width="4" Height="24" Fill="{StaticResource IronBrush}" />
      <Rectangle Canvas.Left="26" Canvas.Top="71" Width="12" Height="3" Fill="{StaticResource IronBrush}" />
      <Ellipse Canvas.Left="12" Canvas.Top="72" Width="40" Height="7" Fill="#EEF5FA" />
    </Canvas>
  </Viewbox>
</UserControl>
