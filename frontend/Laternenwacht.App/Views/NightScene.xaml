      <DoubleAnimation Storyboard.TargetName="StarsA" Storyboard.TargetProperty="Opacity" From="0.35" To="0.8" Duration="0:0:3.4" />
      <DoubleAnimation Storyboard.TargetName="StarsC" Storyboard.TargetProperty="Opacity" From="0.9" To="0.5" Duration="0:0:4.1" />
    </Storyboard>
  </UserControl.Resources>

