<!--
  Hauptfenster im Gestaltungssystem "Laternendickicht":
  eigene dunkle Kopfleiste mit Wappen (Schild mit Laterne) und "Laternenwacht · Chroniken des Lichts",
  links die Kapitel I–IV mit römischen Ziffern und darunter das Wachssiegel der Chronik,
  rechts die Seiten (Views/WatchPage, ChroniclePage, SettingsPage, AboutPage).
-->
<Window x:Class="Laternenwacht.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Laternenwacht.App.Views"
        xmlns:vm="clr-namespace:Laternenwacht.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Laternenwacht"
        Width="1240" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/laterne.ico"
        Background="{StaticResource NightBrush}"
        Foreground="{StaticResource IvoryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">

  <!-- Eigene, dunkle Fensterleiste statt der weißen Standard-Titelleiste (Höhe = Kopfleiste) -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="62" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Römische Kapitelziffer: gold im gewählten Kapitel, sonst gedämpft -->
    <Style x:Key="NavNumeral" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#8F8A78" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Kapitelsymbol (20×20, Linie): gold im gewählten Kapitel, sonst in Textfarbe -->
    <Style x:Key="NavIcon" TargetType="Path" BasedOn="{StaticResource LineIcon}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
          <Setter Property="Stroke" Value="{StaticResource GoldBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="NavTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Kapitel in der Navigation: gewählt = zarte Goldfläche mit Goldkante -->
    <Style x:Key="NavItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bg" MinHeight="48" Margin="0,0,0,6" Padding="12,0" CornerRadius="10"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource GlassBrush}" />
                <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1AE7B75F" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="#61E7B75F" />
                <Setter Property="Foreground" Value="#F6E7C4" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Warmer Laternenschimmer und feines Korn für Tiefe -->
    <Rectangle Grid.RowSpan="2" Fill="{StaticResource AmbientGlowBrush}" IsHitTestVisible="False" />
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.05">
      <Rectangle.Fill>
        <ImageBrush ImageSource="pack://application:,,,/Assets/korn.png" TileMode="Tile" Viewport="0,0,160,160" ViewportUnits="Absolute" />
      </Rectangle.Fill>
    </Rectangle>

    <!-- ===== Kopfleiste: Wappen, Name, Fensterknöpfe ===== -->
    <Border Height="62" Background="{StaticResource HeaderBrush}" BorderBrush="#38C9A056" BorderThickness="0,0,0,1">
      <Grid Margin="22,0,14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Wappen: Schild mit Laterne -->
          <Viewbox Width="34" Height="38" Stretch="Uniform" VerticalAlignment="Center">
            <Canvas Width="36" Height="40">
              <Path Data="{StaticResource CrestGeometry}" Fill="#12241F" Stroke="#C9A056" StrokeThickness="1.5" />
              <Rectangle Canvas.Left="13.5" Canvas.Top="14" Width="9" Height="10" RadiusX="1" RadiusY="1" Fill="#F3C56E" />
              <Path Data="{StaticResource CrestLanternGeometry}" Fill="#C9A056" />
            </Canvas>
          </Viewbox>
          <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Laternenwacht" FontFamily="{StaticResource CinzelDecorativeFont}" FontWeight="Bold" FontSize="21"
                       Foreground="#F6EBD0" />
            <TextBlock Text="CHRONIKEN DES LICHTS" FontFamily="{StaticResource CinzelFont}" FontSize="10" Foreground="#B8A272"
                       Margin="1,1,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- Minimieren, Maximieren, Schließen -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Minimieren" AutomationProperties.Name="Minimieren">
            <Path Data="{StaticResource MinimizeGeometry}" Style="{StaticResource LineIcon}" Width="12" Height="12" StrokeThickness="1.3" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" Click="OnMaximizeRestore" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Maximieren" AutomationProperties.Name="Maximieren" Margin="2,0">
            <Path Data="{StaticResource MaximizeGeometry}" Style="{StaticResource LineIcon}" Width="10" Height="10" StrokeThickness="1.3" />
          </Button>
          <Button Style="{StaticResource ChromeButton}" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"
                  Tag="{StaticResource ErrorTintBrush}" ToolTip="Schließen" AutomationProperties.Name="Schließen">
            <Path Data="{StaticResource CrossGeometry}" Style="{StaticResource LineIcon}" Width="11" Height="11" StrokeThickness="1.3" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="268" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Kapitel ===== -->
            <Border BorderBrush="#29C9A056" BorderThickness="0,0,1,0">
              <DockPanel Margin="16,26,16,22">
                <TextBlock DockPanel.Dock="Top" Text="KAPITEL" FontFamily="{StaticResource CinzelFont}" FontSize="10"
                           Foreground="#8F8A78" Margin="12,0,0,10" />

                <!-- Siegel der Chronik: rotes Wachs mit Laterne, gebrochen = kaltes Grau mit Kreuz -->
                <Border DockPanel.Dock="Bottom" Padding="14,12" CornerRadius="12" BorderThickness="1"
                        ToolTip="{Binding Chronicle.SealMessage}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
                      <Setter Property="Background" Value="#B30D1A1F" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Chronicle.IsSealIntact}" Value="False">
                          <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                          <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:WaxSeal Diameter="44" VerticalAlignment="Center">
                      <views:WaxSeal.Style>
                        <Style TargetType="views:WaxSeal">
                          <Setter Property="SealBrush" Value="{StaticResource NarniaRedBrush}" />
                          <Setter Property="Glyph" Value="{StaticResource SealLanternGeometry}" />
                          <Setter Property="IsGlyphFilled" Value="True" />
                          <Setter Property="GlyphBrush" Value="#EBA898" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Chronicle.IsSealIntact}" Value="False">
                              <Setter Property="SealBrush" Value="#5B5148" />
                              <Setter Property="Glyph" Value="{StaticResource CrossGeometry}" />
                              <Setter Property="IsGlyphFilled" Value="False" />
                              <Setter Property="GlyphBrush" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </views:WaxSeal.Style>
                    </views:WaxSeal>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Chronicle.SealShort}" FontFamily="{StaticResource CinzelFont}" FontSize="13"
                                 FontWeight="SemiBold" Foreground="{StaticResource IvoryBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Chronicle.SealDetailShort}" FontSize="15" Foreground="{StaticResource MossBrush}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>

                <StackPanel IsItemsHost="True" />
              </DockPanel>
            </Border>

            <!-- ===== Seiteninhalt ===== -->
            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" Margin="32,26,32,30" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>

      <!-- I · Die Wacht -->
      <TabItem Style="{StaticResource NavItem}" AutomationProperties.Name="Kapitel I: Die Wacht">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="I" Style="{StaticResource NavNumeral}" />
            <Path Data="{StaticResource LanternGeometry}" Style="{StaticResource NavIcon}" />
            <TextBlock Text="Die Wacht" Style="{StaticResource NavTitle}" />
          </StackPanel>
        </TabItem.Header>
        <views:WatchPage DataContext="{Binding Session}" />
      </TabItem>

      <!-- II · Chronik -->
      <TabItem Style="{StaticResource NavItem}" AutomationProperties.Name="Kapitel II: Chronik">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="II" Style="{StaticResource NavNumeral}" />
            <Path Data="{StaticResource BookGeometry}" Style="{StaticResource NavIcon}" />
            <TextBlock Text="Chronik" Style="{StaticResource NavTitle}" />
          </StackPanel>
        </TabItem.Header>
        <views:ChroniclePage DataContext="{Binding Chronicle}" />
      </TabItem>

      <!-- III · Gefährten & Verlockungen (Einstellungen) -->
      <TabItem Style="{StaticResource NavItem}" AutomationProperties.Name="Kapitel III: Gefährten und Verlockungen">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="III" Style="{StaticResource NavNumeral}" />
            <Path Data="{StaticResource ShieldGeometry}" Style="{StaticResource NavIcon}" />
            <TextBlock Text="Gefährten &amp; Verlockungen" Style="{StaticResource NavTitle}" />
          </StackPanel>
        </TabItem.Header>
        <views:SettingsPage DataContext="{Binding Settings}" />
      </TabItem>

      <!-- IV · Über das Reich -->
      <TabItem Style="{StaticResource NavItem}" AutomationProperties.Name="Kapitel IV: Über das Reich">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="IV" Style="{StaticResource NavNumeral}" />
            <Path Data="{StaticResource CompassGeometry}" Style="{StaticResource NavIcon}" />
            <TextBlock Text="Über das Reich" Style="{StaticResource NavTitle}" />
          </StackPanel>
        </TabItem.Header>
        <views:AboutPage />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
