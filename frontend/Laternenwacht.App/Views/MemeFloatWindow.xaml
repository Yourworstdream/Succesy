<!--
  Treibgut im Fluss der Ablenkung: Ein Meme schwimmt schaukelnd quer über den Bildschirm.
  Ein Klick lässt es versinken.
-->
<Window x:Class="Laternenwacht.App.Views.MemeFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laternenwacht – Treibgut"
        SizeToContent="WidthAndHeight" Left="-10000" Top="-10000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" Cursor="Hand" Opacity="0"
        ToolTip="Klicken, um das Treibgut versinken zu lassen"
        AutomationProperties.Name="Meme bei Ablenkung">
  <!-- Rand lässt Platz für Schaukeln und Schatten -->
  <Grid Margin="26">
    <Border x:Name="Card" Background="{StaticResource ParchmentGradientBrush}" BorderBrush="{StaticResource GoldDimBrush}"
            BorderThickness="1.5" CornerRadius="8" Padding="8,8,8,6" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <RotateTransform x:Name="Tilt" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black" />
      </Border.Effect>
      <StackPanel>
        <Border CornerRadius="4" ClipToBounds="True">
          <Image x:Name="Picture" MaxWidth="300" MaxHeight="300" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock Text="Treibgut im Fluss der Ablenkung" FontSize="12" FontStyle="Italic"
                   Foreground="#6B5A43" HorizontalAlignment="Center" Margin="0,6,0,0" />
        <TextBlock x:Name="CaptionText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CrimsonBrush}"
                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
