<!--
  Kapitel III · "Gefährten & Verlockungen" – Einstellungen.
  DataContext: SettingsViewModel (vom Hauptfenster gesetzt: Settings).
  Gestaltung: Nachtflächen (Glass) mit Kapitelzeile, Cinzel-Überschriften mit goldenem Symbol und EB-Garamond-Text.
  Gefährten = Arbeitsprogramme, Verlockungen = Ablenkungen (so sprechen auch die Texte der Wacht).
-->
<UserControl x:Class="Laternenwacht.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Laternenwacht.App.Views"
             xmlns:vm="clr-namespace:Laternenwacht.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="860" d:DesignHeight="700">

  <UserControl.Resources>
    <views:TextToVisibilityConverter x:Key="TextToVisibility" />
    <views:ErrorToBrushConverter x:Key="ErrorToBrush" />

    <!-- Goldenes Symbol vor einer Kartenüberschrift -->
    <Style x:Key="CardGlyph" TargetType="Path" BasedOn="{StaticResource LineIcon}">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Stroke" Value="{StaticResource GoldBrush}" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!-- Feine Goldlinie unter einer Kartenüberschrift -->
    <Style x:Key="CardRule" TargetType="Rectangle">
      <Setter Property="Height" Value="1" />
      <Setter Property="Fill" Value="{StaticResource EdgeBrush}" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22">
      <TextBlock Text="KAPITEL III" Style="{StaticResource PageEyebrow}" />
      <TextBlock Text="Gefährten &amp; Verlockungen" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
      <TextBlock Text="Was zählt als Fokus, was als Ablenkung – und wie die Laternenwacht dich begleitet." Style="{StaticResource PageSubtitle}" />
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <ItemsControl ItemsSource="{Binding Errors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource ErrorBrush}" FontSize="13" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Body}" FontSize="13"
                     Foreground="{Binding StatusIsError, Converter={StaticResource ErrorToBrush}}"
                     Visibility="{Binding StatusMessage, Converter={StaticResource TextToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource GhostButton}" Command="{Binding DefaultsCommand}" Content="Standardwerte" />
          <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}" Content="Verwerfen" Margin="8,0,0,0" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Content="Speichern" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel>
        <!-- Erkennung -->
        <Border Style="{StaticResource Glass}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource ShieldGeometry}" Style="{StaticResource CardGlyph}" />
              <TextBlock Text="Erkennung" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Style="{StaticResource CardRule}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,14"
                       Text="Programmnamen, einer pro Zeile (z. B. devenv oder discord.exe). Erfasst wird nur, welches Programm im Vordergrund ist – nie Fenstertitel, Inhalte oder Tastatureingaben." />
            <RadioButton GroupName="Mode" IsChecked="{Binding UseBlockList}">
              <StackPanel>
                <TextBlock Text="Mild" FontWeight="SemiBold" />
                <TextBlock Text="Nur Ablenkungen zählen als Frost – alles andere gilt als Fokus." Style="{StaticResource Caption}" FontSize="13" />
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Mode" IsChecked="{Binding UseAllowList}">
              <StackPanel>
                <TextBlock Text="Streng" FontWeight="SemiBold" />
                <TextBlock Text="Nur Arbeitsprogramme zählen als Fokus – alles andere ist Frost." Style="{StaticResource Caption}" FontSize="13" />
              </StackPanel>
            </RadioButton>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="GEFÄHRTEN · ARBEITSPROGRAMME" Style="{StaticResource Overline}" Foreground="{StaticResource GoldBrush}" Margin="0,0,0,8" />
                <TextBox Text="{Binding AllowedText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" MaxLength="12000" AutomationProperties.Name="Arbeitsprogramme" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="VERLOCKUNGEN · ABLENKUNGEN" Style="{StaticResource Overline}" Foreground="{StaticResource FrostBrush}" Margin="0,0,0,8" />
                <TextBox Text="{Binding DistractingText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="150"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" MaxLength="12000" AutomationProperties.Name="Ablenkungen" />
              </StackPanel>
            </Grid>

            <CheckBox IsChecked="{Binding UseKnownDistractions}" Margin="0,16,0,0" ToolTip="{Binding KnownDistractionsList}">
              <StackPanel>
                <TextBlock Text="Bekannte Ablenkungen automatisch erkennen" />
                <TextBlock Text="Spiele, Launcher und Messenger wie Hearthstone, Steam oder Discord. Arbeitsprogramme haben Vorrang." Style="{StaticResource Caption}" FontSize="13" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- Wacht -->
        <Border Style="{StaticResource Glass}" Margin="0,16,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource LanternGeometry}" Style="{StaticResource CardGlyph}" />
              <TextBlock Text="Wacht" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Style="{StaticResource CardRule}" />
            <WrapPanel Margin="0,16,0,0">
              <StackPanel Margin="0,0,24,0" Width="220">
                <TextBlock Text="STANDARDDAUER (MIN)" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" />
              </StackPanel>
              <StackPanel Width="220">
                <TextBlock Text="ABWESEND NACH (SEK.)" Style="{StaticResource Overline}" Margin="0,0,0,8" />
                <TextBox Text="{Binding IdleText, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" />
              </StackPanel>
            </WrapPanel>
            <CheckBox IsChecked="{Binding BarAlwaysOnTop}" Margin="0,16,0,0" Content="Fokusleiste stets über allen Fenstern" />
            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetBarPositionCommand}" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Content="Fokusleiste wieder oben mittig anordnen" />
          </StackPanel>
        </Border>

        <!-- Botschaften -->
        <Border Style="{StaticResource Glass}" Margin="0,16,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource BookGeometry}" Style="{StaticResource CardGlyph}" />
              <TextBlock Text="Botschaften" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Style="{StaticResource CardRule}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,14"
                       Text="Lob für lange Fokus-Serien, ein Gruß bei der Rückkehr und – auf Wunsch – Mahnrufe. Die Reise erzählt immer Band II; der gewählte Band bestimmt, wer dir unterwegs Rabenboten schickt. Änderungen gelten sofort." />
            <TextBlock Text="BUCH" Style="{StaticResource Overline}" Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding BookOptions}" SelectedItem="{Binding SelectedBookOption}"
                      DisplayMemberPath="Label" MaxWidth="440" MinWidth="360" HorizontalAlignment="Left"
                      AutomationProperties.Name="Buch der Botschaften" />
            <CheckBox IsChecked="{Binding ShowPraise}" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Lob und „Willkommen zurück“" />
                <TextBlock Text="Leise Botschaften bei Fokus-Serien, Rückkehr zur Arbeit und neuen Bestleistungen." Style="{StaticResource Caption}" FontSize="13" />
              </StackPanel>
            </CheckBox>
            <CheckBox IsChecked="{Binding ShowNotifications}">
              <StackPanel>
                <TextBlock Text="Mahnrufe bei vielen Ablenkungen" />
                <TextBlock Text="Mit Ton – abschalten, wenn du nur Positives sehen möchtest. In Band II lockt die Königin, und Narnia antwortet ihr." Style="{StaticResource Caption}" FontSize="13" TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- Memes -->
        <Border Style="{StaticResource Glass}" Margin="0,16,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource CardGlyph}" />
              <TextBlock Text="Memes" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <Rectangle Style="{StaticResource CardRule}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,12,0,10"
                       Text="Bei jeder neuen Ablenkung treibt ein Meme über den Bildschirm. Ein Klick lässt es versinken. Erlaubt: JPG, PNG, BMP, GIF bis 10 MB." />
            <CheckBox IsChecked="{Binding ShowMemes}" Content="Memes bei Ablenkung zeigen" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddMemesCommand}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource PlusGeometry}" Style="{StaticResource LineIcon}" Width="14" Height="14" StrokeThickness="2" />
                  <TextBlock Text="Memes hinzufügen" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Style="{StaticResource GhostButton}" Command="{Binding OpenMemeFolderCommand}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource FolderGeometry}" Style="{StaticResource LineIcon}" Width="16" Height="16" />
                  <TextBlock Text="Ordner öffnen" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding MemeSummary}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
