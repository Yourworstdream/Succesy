<!--
  Botschaft (Push-Benachrichtigung) unten rechts: Lob, Willkommensgruß oder Mahnruf.
  Ein runder Avatar mit dem Anfangsbuchstaben des Sprechers, darunter Zitat und Quelle.
-->
<Window x:Class="Laternenwacht.App.Views.RavenToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laternenwacht – Botschaft"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" Cursor="Hand"
        AutomationProperties.Name="Botschaft der Laternenwacht">
  <Grid x:Name="Root" Margin="20" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" X="60" />
    </Grid.RenderTransform>

    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="20" Padding="16,16,18,14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.22" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Avatar" Width="40" Height="40" CornerRadius="20" Background="{StaticResource LightTintBrush}"
                VerticalAlignment="Top">
          <TextBlock x:Name="AvatarText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                     Foreground="{StaticResource LightInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <Grid>
            <TextBlock x:Name="HeaderText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource LightInkBrush}" />
            <Path Data="{StaticResource CrossGeometry}" Stroke="{StaticResource Ink3Brush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="9"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Schließen" />
          </Grid>
          <TextBlock x:Name="MessageText" Margin="0,4,0,0" FontSize="15" LineHeight="21"
                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive" />
          <TextBlock x:Name="SourceText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Ink3Brush}" TextWrapping="Wrap" />
          <ProgressBar x:Name="Lifetime" Margin="0,12,0,0" Style="{StaticResource SlimProgress}" Value="1" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
