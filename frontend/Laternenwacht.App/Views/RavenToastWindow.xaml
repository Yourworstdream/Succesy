<!--
  Botschaft (Push-Benachrichtigung) unten rechts: Lob, Willkommensgruß oder Mahnruf.
  Ein runder Avatar mit dem Anfangsbuchstaben des Sprechers, darunter Zitat und Quelle.
-->
<Window x:Class="Laternenwacht.App.Views.RavenToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laternenwacht – Botschaft"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" Cursor="Hand"
        AutomationProperties.Name="Botschaft der Laternenwacht">
  <Grid x:Name="Root" Margin="20" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" X="60" />
    </Grid.RenderTransform>

    <Border Background="{StaticResource CapsuleBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
            CornerRadius="20" Padding="16,16,18,14">
      <Border.Effect>
        <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.4" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Avatar: Anfangsbuchstabe des Sprechers in einem leuchtenden Ring -->
        <Border x:Name="Avatar" Width="42" Height="42" CornerRadius="21" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5"
                Background="{StaticResource GoldTintBrush}" VerticalAlignment="Top">
          <Border.Effect>
            <DropShadowEffect x:Name="AvatarGlow" BlurRadius="16" ShadowDepth="0" Color="{StaticResource GoldColor}" Opacity="0.35" />
          </Border.Effect>
          <TextBlock x:Name="AvatarText" FontFamily="{StaticResource SerifFont}" FontSize="19"
                     Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
        </Border>

        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <Grid>
            <TextBlock x:Name="HeaderText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
            <Path Data="{StaticResource CrossGeometry}" Stroke="{StaticResource MossBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="9" Height="9"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Schließen" />
          </Grid>
          <TextBlock x:Name="MessageText" Margin="0,5,0,0" FontFamily="{StaticResource SerifTextFont}" FontSize="16" LineHeight="23"
                     Foreground="{StaticResource IvoryBrush}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Assertive" />
          <TextBlock x:Name="SourceText" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource MossBrush}" TextWrapping="Wrap" />
          <ProgressBar x:Name="Lifetime" Margin="0,12,0,0" Style="{StaticResource SlimProgress}" Height="3" Value="1" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
