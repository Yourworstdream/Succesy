<!--
  Der Rabenbote: eine Push-Benachrichtigung im Pergament-Stil, die unten rechts
  einfliegt und einen Mahnruf aus dem gewählten Buch der Chroniken überbringt.
-->
<Window x:Class="Laternenwacht.App.Views.RavenToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laternenwacht – Botschaft"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" Cursor="Hand"
        AutomationProperties.Name="Botschaft der Laternenwacht">
  <Grid x:Name="Root" Margin="12" RenderTransformOrigin="0.5,0.5" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="Slide" X="60" />
    </Grid.RenderTransform>

    <Border Background="{StaticResource ParchmentGradientBrush}" BorderBrush="{StaticResource GoldDimBrush}"
            BorderThickness="1.5" CornerRadius="8" Padding="16,12,16,12">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Wachssiegel -->
        <Grid Grid.RowSpan="3" Width="40" Height="40" Margin="0,2,12,0" VerticalAlignment="Top">
          <Ellipse x:Name="SealOuter" Fill="{StaticResource CrimsonBrush}" Stroke="#4A0F18" StrokeThickness="1.5" />
          <Ellipse x:Name="SealRing" Margin="5" Stroke="#C9737E" StrokeThickness="1" />
          <TextBlock x:Name="SealGlyph" Text="❦" FontSize="18" Foreground="#F3D6A0" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <TextBlock x:Name="HeaderText" Grid.Column="1" Text="Ein Rabe bringt Kunde" FontSize="12" FontWeight="SemiBold"
                   Foreground="#6B5A43" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="✕" FontSize="13" Foreground="#6B5A43" Margin="8,0,0,0"
                   ToolTip="Schließen" VerticalAlignment="Center" />

        <TextBlock x:Name="MessageText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,6"
                   FontSize="15" FontStyle="Italic" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Assertive" />

        <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                   FontSize="12" Foreground="{StaticResource GoldDimBrush}" HorizontalAlignment="Right" />

        <!-- Verbleibende Anzeigedauer -->
        <ProgressBar x:Name="Lifetime" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10,0,0" Height="3"
                     Style="{StaticResource QuestProgress}" Background="#22000000" Value="1" />
      </Grid>
    </Border>
  </Grid>
</Window>
