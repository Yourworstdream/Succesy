<!--
  Kapitel II · "Die Chronik" – versiegelte Historie der Wachten, erzählt als Bilder aus "Der König von Narnia".
  DataContext: ChronicleViewModel (vom Hauptfenster gesetzt: Chronicle).

  Aufbau (wie im Entwurf Chronik.dc.html):
    Kopf          KAPITEL II · Die Chronik · Untertitel
    Siegelkarte   Wachssiegel (rot mit Laterne, gebrochen grau mit Kreuz), Prüftext, ggf. Archiv-Hinweis
    Kennzahlen    VOLLENDET · IM LICHT · IM FROST · KRONEN · REKORD-SERIE
    Verzeichnis   Pergament "Verzeichnis der Wachten": Wacht (Datum + Bildtitel), Reise (kleines Wegband + Text),
                  Frost, Honig, Jahreszeit, Siegel – virtualisiert und bei Bedarf waagerecht scrollbar
    Seitenleiste  "Die Bilder der Chronik": Krönungen, Tauwetter, Steinhof mit Balken, darunter der Schlusssatz

  Breitenabhängig (ChroniclePage.xaml.cs): Ab 1130 px steht die Seitenleiste rechts neben dem Verzeichnis, darunter
  als flacher Streifen unter ihm; unter 820 px rutschen die Kennzahlen unter die Siegelkarte.

  Sparsam: Jede Zeile wird nur erzeugt, wenn sie sichtbar ist (VirtualizingStackPanel, Recycling). Alle Texte einer Zeile
  sind einmal je Wacht berechnet; das kleine Wegband zeichnet sich selbst ohne eigene Unterelemente; Symbole sind
  eingefrorene, geteilte Zeichnungen.
-->
<UserControl x:Class="Laternenwacht.App.Views.ChroniclePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:views="clr-namespace:Laternenwacht.App.Views"
             xmlns:vm="clr-namespace:Laternenwacht.App.ViewModels"
             xmlns:core="clr-namespace:Laternenwacht.Core.Tracking;assembly=Laternenwacht.Core"
             mc:Ignorable="d po"
             d:DataContext="{d:DesignInstance Type=vm:ChronicleViewModel}"
             d:DesignWidth="908" d:DesignHeight="760">

  <UserControl.Resources>
    <views:StarConverter x:Key="Star" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Farben aus dem Entwurf, die nur diese Seite braucht -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#C9BFA6" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelRuleBrush" Color="#29C9A056" po:Freeze="True" />
    <SolidColorBrush x:Key="HeadRuleBrush" Color="#806B5434" po:Freeze="True" />
    <SolidColorBrush x:Key="RowRuleBrush" Color="#386B5434" po:Freeze="True" />
    <SolidColorBrush x:Key="StoryInkBrush" Color="#6B4A16" po:Freeze="True" />
    <SolidColorBrush x:Key="InkWinterBrush" Color="#3D4F63" po:Freeze="True" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#1AF1E6CC" po:Freeze="True" />
    <SolidColorBrush x:Key="CoronationBarBrush" Color="#8DB35A" po:Freeze="True" />
    <SolidColorBrush x:Key="ThawBarBrush" Color="#6FAFD0" po:Freeze="True" />
    <SolidColorBrush x:Key="CourtyardBarBrush" Color="#8E9DAA" po:Freeze="True" />

    <!-- Symbole der Seitenleiste (20×20, Linien): Schlitten im Matsch, Steinfigur auf Sockel; Flocke der Jahreszeit -->
    <Geometry x:Key="SledgeInMudGeometry">M 2.5,12.2 h 11 c 1.4,0 2.3,-0.9 2.3,-2.1 M 4.2,12.2 V 9.4 h 8.4 l 1.4,-3.8 c 0.4,-1 1.4,-1.2 1.9,-0.5 M 6.4,9.4 v 2.8 M 10.6,9.4 v 2.8 M 2,15.6 q 2,-1.4 4,0 t 4,0 t 4,0 t 4,0 M 4,18.2 q 1.6,-1 3.2,0 t 3.2,0 t 3.2,0</Geometry>
    <Geometry x:Key="StatueGeometry">M 4.5,18.5 h 11 M 6,18.5 V 16 h 8 v 2.5 M 8,5 a 2,2 0 1 0 4,0 a 2,2 0 1 0 -4,0 M 7.4,16 v -5 c 0,-1.7 1.1,-3 2.6,-3 s 2.6,1.3 2.6,3 v 5 M 7.4,11.2 L 5.6,9.4 M 12.6,11.2 l 1.8,-1.8</Geometry>
    <Geometry x:Key="SeasonWinterGeometry">M 10,2 V 18 M 3,6 L 17,14 M 3,14 L 17,6</Geometry>

    <!-- Ein Stück Türkischer Honig (Würfel mit rotem Rand, zwei Zuckerpunkte) -->
    <DrawingImage x:Key="HoneyCubeImage" po:Freeze="True">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#F4EBDD">
            <GeometryDrawing.Pen>
              <Pen Brush="#9E2B1F" Thickness="1.6" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="2,2,14,14" RadiusX="2.5" RadiusY="2.5" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#CDBB9C">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="6.4,6.8" RadiusX="1.2" RadiusY="1.2" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#CDBB9C">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="11.4,11" RadiusX="1.2" RadiusY="1.2" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Siegel einer Zeile: rotes Wachs mit Haken (geprüft) bzw. graues Wachs mit Strich (ungeprüft) -->
    <DrawingImage x:Key="RowSealImage" po:Freeze="True">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#9E2B1F">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M 4.8,8.2 L 7,10.3 L 11.2,5.8">
            <GeometryDrawing.Pen>
              <Pen Brush="#F6E2D8" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="RowUnsealedImage" po:Freeze="True">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#8C7F6E">
            <GeometryDrawing.Geometry>
              <EllipseGeometry Center="8,8" RadiusX="7" RadiusY="7" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M 5,8 L 11,8">
            <GeometryDrawing.Pen>
              <Pen Brush="#F1E6CC" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" />
            </GeometryDrawing.Pen>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Kennzahl-Zelle: Beschriftung oben, Wert darunter (schrumpft bei schmalen Fenstern, wächst nie) -->
    <Style x:Key="MetricCell" TargetType="Border">
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelRuleBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="MetricValue" TargetType="Viewbox">
      <Setter Property="StretchDirection" Value="DownOnly" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Spaltenköpfe des Verzeichnisses -->
    <Style x:Key="LedgerHead" TargetType="TextBlock" BasedOn="{StaticResource InkOverline}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Margin" Value="10,10,10,8" />
    </Style>

    <!-- Zeile der Seitenleiste: Symbol + Name links, Anzahl rechts -->
    <Style x:Key="PictureName" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PictureCount" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource IvoryBrightBrush}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Kopf ===== -->
    <StackPanel>
      <TextBlock Text="KAPITEL II" Style="{StaticResource PageEyebrow}" />
      <TextBlock Text="Die Chronik" Style="{StaticResource PageTitle}" Margin="0,4,0,0" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="Jede Wacht wird versiegelt und mit der vorigen verkettet. Schriebe jemand eine Seite um, bräche das Siegel." />
    </StackPanel>

    <!-- ===== Siegelkarte und Kennzahlen ===== -->
    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="TopGapColumn" Width="24" />
        <ColumnDefinition x:Name="MetricsColumn" Width="2*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Siegel: rot mit Laterne, solange die Kette stimmt; gebrochen grau mit Kreuz und roter Kante -->
      <Border x:Name="SealPanel" CornerRadius="14" BorderThickness="1" Padding="24,20" ToolTip="{Binding SealMessage}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NightPanelBrush}" />
            <Setter Property="BorderBrush" Value="#4DC9A056" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSealIntact}" Value="False">
                <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                <Setter Property="Background" Value="{StaticResource ErrorTintBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <views:WaxSeal Diameter="76" VerticalAlignment="Center" AutomationProperties.Name="{Binding SealShort}">
            <views:WaxSeal.Style>
              <Style TargetType="views:WaxSeal">
                <Setter Property="SealBrush" Value="{StaticResource NarniaRedBrush}" />
                <Setter Property="Glyph" Value="{StaticResource SealLanternGeometry}" />
                <Setter Property="IsGlyphFilled" Value="True" />
                <Setter Property="GlyphBrush" Value="#EBA898" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSealIntact}" Value="False">
                    <Setter Property="SealBrush" Value="#5B5148" />
                    <Setter Property="Glyph" Value="{StaticResource CrossGeometry}" />
                    <Setter Property="IsGlyphFilled" Value="False" />
                    <Setter Property="GlyphBrush" Value="{StaticResource ErrorBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:WaxSeal.Style>
          </views:WaxSeal>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding SealHeadline}" FontFamily="{StaticResource CinzelFont}" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource IvoryBrightBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SealText}" Style="{StaticResource Body}" FontSize="17" LineHeight="24"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ArchiveHint}" Style="{StaticResource Body}" FontSize="15" LineHeight="21"
                       Foreground="{StaticResource ErrorBrush}" Margin="0,8,0,0"
                       Visibility="{Binding HasArchiveHint, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Kennzahlen -->
      <Border x:Name="MetricsPanel" Grid.Column="2" Background="{StaticResource NightPanelBrush}" BorderBrush="#4DC9A056"
              BorderThickness="1" CornerRadius="14" VerticalAlignment="Stretch">
        <UniformGrid Rows="1" Columns="5" VerticalAlignment="Center">
          <Border Style="{StaticResource MetricCell}" ToolTip="Vollendete Wachten – jede hat Cair Paravel erreicht">
            <StackPanel>
              <TextBlock Text="VOLLENDET" Style="{StaticResource MetricLabel}" />
              <Viewbox Style="{StaticResource MetricValue}">
                <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource Metric}" Margin="0" />
              </Viewbox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCell}" ToolTip="Fokuszeit aller Wachten (Stunden:Minuten)">
            <StackPanel>
              <TextBlock Text="IM LICHT" Style="{StaticResource MetricLabel}" />
              <Viewbox Style="{StaticResource MetricValue}">
                <TextBlock Text="{Binding TotalFocusedText}" Style="{StaticResource Metric}" Margin="0" />
              </Viewbox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCell}" ToolTip="Ablenkungszeit aller Wachten (Stunden:Minuten)">
            <StackPanel>
              <TextBlock Text="IM FROST" Style="{StaticResource MetricLabel}" />
              <Viewbox Style="{StaticResource MetricValue}">
                <TextBlock Text="{Binding TotalFrostText}" Style="{StaticResource Metric}" Margin="0" Foreground="{StaticResource FrostBrush}" />
              </Viewbox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCell}" ToolTip="Vollendete Wachten im Frühling – jede endete mit der Krönung in Cair Paravel">
            <StackPanel>
              <TextBlock Text="KRONEN" Style="{StaticResource MetricLabel}" />
              <Viewbox Style="{StaticResource MetricValue}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource CrownGeometry}" Stroke="{StaticResource GoldBrush}" Width="16" Height="16" Stretch="Uniform"
                        StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding CrownCount}" Style="{StaticResource Metric}" Margin="0" Foreground="{StaticResource GoldBrush}" />
                </StackPanel>
              </Viewbox>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource MetricCell}" BorderThickness="0" ToolTip="Deine Bestleistung: längste ununterbrochene Fokusphase">
            <StackPanel>
              <TextBlock Text="REKORD-SERIE" Style="{StaticResource MetricLabel}" />
              <Viewbox Style="{StaticResource MetricValue}">
                <TextBlock Text="{Binding BestStreakText}" Style="{StaticResource Metric}" Margin="0" Foreground="{StaticResource GoldBrush}" />
              </Viewbox>
            </StackPanel>
          </Border>
        </UniformGrid>
      </Border>
    </Grid>

    <!-- ===== Verzeichnis und Seitenleiste ===== -->
    <Grid Grid.Row="2" Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Pergament: Verzeichnis der Wachten -->
      <ContentControl Style="{StaticResource ParchmentCard}" Padding="30,30,30,24">
        <DockPanel>
          <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Verzeichnis der Wachten" Style="{StaticResource InkTitle}" FontSize="25" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="neueste zuerst" FontStyle="Italic" FontSize="16" Foreground="{StaticResource InkMutedBrush}"
                       VerticalAlignment="Bottom" Margin="16,0,0,3" />
          </Grid>
          <views:OrnamentDivider DockPanel.Dock="Top" Ink="{StaticResource InkGoldBrush}" Margin="0,12,0,6" />

          <Grid>
            <!-- Leerzustand -->
            <TextBlock Text="Noch keine Wacht verzeichnet. Beginne deine erste – sie erscheint dann hier als Bild der Reise."
                       FontStyle="Italic" FontSize="18" LineHeight="25" Foreground="{StaticResource InkMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!--
              Waagerecht scrollbar, sobald das Pergament schmaler als die Tabelle ist: Die Tabelle ist so breit wie der
              sichtbare Bereich, mindestens aber LedgerMinWidth. Senkrecht scrollt die virtualisierte Liste selbst
              (der Kopf bleibt stehen und liegt in derselben Spalte wie die Zeilen – so passen die Spalten genau).
            -->
            <ScrollViewer x:Name="LedgerScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
              <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Left"
                            MinWidth="{x:Static views:ChroniclePage.LedgerMinWidth}"
                            Width="{Binding ViewportWidth, ElementName=LedgerScroller}"
                            Focusable="False" AutomationProperties.Name="Verzeichnis der Wachten"
                            Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                  <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <ScrollViewer.Template>
                        <ControlTemplate TargetType="ScrollViewer">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Spaltenköpfe: gleiche Spaltenbreiten wie die Zeilen -->
                            <Border BorderBrush="{StaticResource HeadRuleBrush}" BorderThickness="0,0,0,1.5">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="200" />
                                  <ColumnDefinition Width="76" />
                                  <ColumnDefinition Width="64" />
                                  <ColumnDefinition Width="118" />
                                  <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="WACHT" Style="{StaticResource LedgerHead}" Margin="0,10,10,8" />
                                <TextBlock Grid.Column="1" Text="REISE" Style="{StaticResource LedgerHead}" />
                                <TextBlock Grid.Column="2" Text="FROST" Style="{StaticResource LedgerHead}" />
                                <TextBlock Grid.Column="3" Text="HONIG" Style="{StaticResource LedgerHead}" />
                                <TextBlock Grid.Column="4" Text="JAHRESZEIT" Style="{StaticResource LedgerHead}" />
                                <TextBlock Grid.Column="5" Text="SIEGEL" Style="{StaticResource LedgerHead}" Margin="10,10,0,8" />
                              </Grid>
                            </Border>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1" Margin="6,4,0,4"
                                       Orientation="Vertical" Minimum="0" Cursor="Arrow"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                          </Grid>
                        </ControlTemplate>
                      </ScrollViewer.Template>
                      <ItemsPresenter />
                    </ScrollViewer>
                  </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:ChronicleEntry}">
                    <Border BorderBrush="{StaticResource RowRuleBrush}" BorderThickness="0,0,0,1" Background="Transparent"
                            ToolTip="{Binding DetailText}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAborted}" Value="True">
                              <Setter Property="Opacity" Value="0.62" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="200" />
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="64" />
                          <ColumnDefinition Width="118" />
                          <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>

                        <!-- Wacht: Datum, darunter der Bildtitel -->
                        <StackPanel Margin="0,12,10,12" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DateText}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding StoryTitle}" FontSize="15.5" FontStyle="Italic" Foreground="{StaticResource StoryInkBrush}"
                                     TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>

                        <!-- Reise: kleines Wegband (gold bis zur erreichten Station) und Text -->
                        <StackPanel Grid.Column="1" Margin="10,12" VerticalAlignment="Center" ToolTip="{Binding JourneyDescription}">
                          <views:ChronicleJourneyMark Station="{Binding StationReached}" HorizontalAlignment="Left"
                                                      AutomationProperties.Name="{Binding JourneyDescription}" />
                          <TextBlock Text="{Binding JourneyText}" FontSize="14" Foreground="{StaticResource InkMutedBrush}"
                                     TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Frost -->
                        <TextBlock Grid.Column="2" Text="{Binding FrostText}" FontSize="17" Foreground="{StaticResource InkFrostBrush}"
                                   VerticalAlignment="Center" Margin="10,0" />

                        <!-- Honig: Würfel und Anzahl, bei 0 ein Gedankenstrich -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0"
                                    ToolTip="{Binding HoneyDescription}">
                          <Image Source="{StaticResource HoneyCubeImage}" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Visibility="{Binding HasHoney, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock Text="{Binding HoneyText}" FontSize="17" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding HasHoney}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>

                        <!-- Jahreszeit: Blatt (Frühling), Tropfen (Tauwetter), Flocke (Winter) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="TextElement.Foreground" Value="{StaticResource InkWinterBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Mood}" Value="{x:Static core:RealmMood.Spring}">
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource InkSpringBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mood}" Value="{x:Static core:RealmMood.Thaw}">
                                  <Setter Property="TextElement.Foreground" Value="{StaticResource InkFrostBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.7" Margin="0,0,7,0" VerticalAlignment="Center"
                                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}">
                            <Path.Style>
                              <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource SeasonWinterGeometry}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Mood}" Value="{x:Static core:RealmMood.Spring}">
                                    <Setter Property="Data" Value="{StaticResource LeafGeometry}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Mood}" Value="{x:Static core:RealmMood.Thaw}">
                                    <Setter Property="Data" Value="{StaticResource DropGeometry}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Path.Style>
                          </Path>
                          <TextBlock Text="{Binding MoodText}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Siegel: geprüft, solange die Wacht versiegelt ist und die Kette stimmt -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                          <Image Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Image.Style>
                              <Style TargetType="Image">
                                <Setter Property="Source" Value="{StaticResource RowSealImage}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSealed}" Value="False">
                                    <Setter Property="Source" Value="{StaticResource RowUnsealedImage}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding DataContext.IsSealIntact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                    <Setter Property="Source" Value="{StaticResource RowUnsealedImage}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Image.Style>
                          </Image>
                          <TextBlock FontSize="15" Foreground="{StaticResource InkMutedBrush}" VerticalAlignment="Center">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="geprüft" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsSealed}" Value="False">
                                    <Setter Property="Text" Value="ungeprüft" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding DataContext.IsSealIntact, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
                                    <Setter Property="Text" Value="ungeprüft" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </ContentControl>

      <!-- ===== Seitenleiste: Die Bilder der Chronik ===== -->
      <Border x:Name="PicturesPanel" Grid.Column="1" Width="260" Margin="24,0,0,0" VerticalAlignment="Top"
              Background="{StaticResource NightPanelBrush}" BorderBrush="#4DC9A056" BorderThickness="1" CornerRadius="14" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="QuoteColumn" Width="0" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Die Bilder der Chronik" FontFamily="{StaticResource CinzelFont}" FontSize="19" FontWeight="SemiBold"
                     Foreground="{StaticResource IvoryBrightBrush}" TextWrapping="Wrap" />

          <UniformGrid x:Name="PictureRows" Grid.Row="1" Columns="1" Margin="-8,8,-8,0">
            <!-- Krönungen (darunter der Anteil an den vollendeten Wachten) -->
            <StackPanel Margin="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Coronations.Count}" Style="{StaticResource PictureCount}" />
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource GoldBrush}">
                  <Path Data="{StaticResource CrownGeometry}" Style="{StaticResource LineIcon}"
                        Stroke="{StaticResource GoldBrush}" />
                  <TextBlock Text="Krönungen" Style="{StaticResource PictureName}" />
                </StackPanel>
              </DockPanel>
              <Grid Height="6" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Coronations.Share, Converter={StaticResource Star}}" />
                  <ColumnDefinition Width="{Binding Coronations.Rest, Converter={StaticResource Star}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" CornerRadius="3" />
                <Border Background="{StaticResource CoronationBarBrush}" CornerRadius="3" />
              </Grid>
              <TextBlock Text="{Binding Coronations.ShareText}" FontSize="14.5" Foreground="{StaticResource MossBrush}" Margin="0,6,0,0"
                         ToolTip="Anteil der vollendeten Wachten, die mit der Krönung endeten" />
            </StackPanel>

            <!-- Tauwetter -->
            <StackPanel Margin="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Thaws.Count}" Style="{StaticResource PictureCount}" />
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource FrostBrush}">
                  <Path Data="{StaticResource SledgeInMudGeometry}" Style="{StaticResource LineIcon}"
                        Stroke="{StaticResource FrostBrush}" />
                  <TextBlock Text="Tauwetter" Style="{StaticResource PictureName}" />
                </StackPanel>
              </DockPanel>
              <Grid Height="6" Margin="0,6,0,0" ToolTip="{Binding Thaws.ShareText}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding Thaws.Share, Converter={StaticResource Star}}" />
                  <ColumnDefinition Width="{Binding Thaws.Rest, Converter={StaticResource Star}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" CornerRadius="3" />
                <Border Background="{StaticResource ThawBarBrush}" CornerRadius="3" />
              </Grid>
            </StackPanel>

            <!-- Steinhof -->
            <StackPanel Margin="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StoneCourtyards.Count}" Style="{StaticResource PictureCount}" />
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource WinterBrush}">
                  <Path Data="{StaticResource StatueGeometry}" Style="{StaticResource LineIcon}"
                        Stroke="{StaticResource WinterBrush}" />
                  <TextBlock Text="Steinhof" Style="{StaticResource PictureName}" />
                </StackPanel>
              </DockPanel>
              <Grid Height="6" Margin="0,6,0,0" ToolTip="{Binding StoneCourtyards.ShareText}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="{Binding StoneCourtyards.Share, Converter={StaticResource Star}}" />
                  <ColumnDefinition Width="{Binding StoneCourtyards.Rest, Converter={StaticResource Star}}" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" CornerRadius="3" />
                <Border Background="{StaticResource CourtyardBarBrush}" CornerRadius="3" />
              </Grid>
            </StackPanel>
          </UniformGrid>

          <!-- Schlusssatz (eigene Formulierung der Laternenwacht, kein Zitat) -->
          <StackPanel x:Name="QuotePart" Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Center">
            <Grid x:Name="QuoteDivider" Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Rectangle Height="1" Fill="#4DC9A056" VerticalAlignment="Center" />
              <Path Grid.Column="1" Data="{StaticResource DiamondGeometry}" Fill="{StaticResource EyebrowBrush}" Width="10" Height="10"
                    Stretch="Uniform" Margin="10,0" />
              <Rectangle Grid.Column="2" Height="1" Fill="#4DC9A056" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="Auch Edmund wurde ein König. Angefangen hat es damit, dass er zurückkam."
                       Style="{StaticResource Quote}" TextAlignment="Left" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
