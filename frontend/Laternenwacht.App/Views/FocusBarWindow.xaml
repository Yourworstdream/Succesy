<!--
  Die Fokusleiste: eine Kapsel aus dunklem Waldglas am oberen Bildschirmrand.
  Lichtring = Fortschritt der Wacht, große Zahl = Restzeit, Chip = Frost (Ablenkungszeit).
  Bei Ablenkung wechseln Ring, Rand und Chip von Kerzenlicht zu Eisblau, und die Kapsel schimmert kalt.
  Ressourcen: Die Leiste ist ein transparentes (geschichtetes) Fenster und bleibt die ganze Wacht sichtbar.
  Deshalb bewegt sich nichts dauerhaft, und Schatten liegen in einer zwischengespeicherten Ebene.
-->
<Window x:Class="Laternenwacht.App.Views.FocusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Laternenwacht.App.Views"
        xmlns:vm="clr-namespace:Laternenwacht.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BarViewModel}"
        Title="Laternenwacht – Fokusleiste"
        Width="580" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <!-- Rechtsklick: Programm markieren, Botschaften, Bücher, Leiste zurücksetzen, Wacht steuern -->
  <Window.ContextMenu>
    <ContextMenu>
      <MenuItem Header="{Binding Session.MarkCandidateLabel}" Command="{Binding MarkAsDistractionCommand}" FontWeight="SemiBold">
        <MenuItem.Icon>
          <Path Data="{StaticResource SnowflakeGeometry}" Stroke="{StaticResource FrostBrush}" StrokeThickness="2"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" />
        </MenuItem.Icon>
      </MenuItem>
      <MenuItem Header="Bekannte Verlockungen erkennen (Spiele, Discord …)"
                IsChecked="{Binding Settings.UseKnownDistractions, Mode=OneWay}"
                Command="{Binding Settings.ToggleKnownDistractionsCommand}" />
      <Separator />
      <MenuItem Header="Sprüche aus dem Buch …" ItemsSource="{Binding Settings.BookOptions}">
        <MenuItem.Icon>
          <Path Data="{StaticResource BookGeometry}" Stroke="{StaticResource SageBrush}" StrokeThickness="1.8"
                StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="14" Height="14" />
        </MenuItem.Icon>
        <MenuItem.ItemContainerStyle>
          <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="Command" Value="{Binding SelectCommand}" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
          </Style>
        </MenuItem.ItemContainerStyle>
      </MenuItem>
      <MenuItem Header="Lob &amp; „Willkommen zurück“"
                IsChecked="{Binding Settings.ShowPraise, Mode=OneWay}"
                Command="{Binding Settings.TogglePraiseCommand}" />
      <MenuItem Header="Mahnrufe bei vielen Ablenkungen"
                IsChecked="{Binding Settings.ShowNotifications, Mode=OneWay}"
                Command="{Binding Settings.ToggleNotificationsCommand}" />
      <MenuItem Header="Memes bei Ablenkung treiben lassen"
                IsChecked="{Binding Settings.ShowMemes, Mode=OneWay}"
                Command="{Binding Settings.ToggleMemesCommand}" />
      <MenuItem Header="Memes hinzufügen …" Command="{Binding Settings.AddMemesCommand}" />
      <Separator />
      <MenuItem Header="Leiste zurück an den oberen Rand" Command="{Binding Settings.ResetBarPositionCommand}" />
      <Separator />
      <MenuItem Header="{Binding Session.PauseResumeLabel}" Command="{Binding Session.PauseResumeCommand}" />
      <MenuItem Header="Wacht abbrechen" Command="{Binding Session.AbortCommand}" />
      <MenuItem Header="Laternenwacht öffnen" Command="{Binding Session.ShowChamberCommand}" />
    </ContextMenu>
  </Window.ContextMenu>

  <Grid Margin="16,10,16,22">
    <!--
      Körper der Kapsel (Hintergrund, Rand, Schatten, Frostschimmer) als eigene, zwischengespeicherte Ebene:
      Er ändert sich nur beim Wechsel zwischen Licht und Frost. Die sekündlich wechselnden Zahlen liegen darüber
      und lassen die Schatten daher nicht jedes Mal neu berechnen.
    -->
    <Grid views:RenderCache.IsEnabled="True" IsHitTestVisible="False" DataContext="{Binding Session}">
      <!-- Eisblauer Schimmer bei Ablenkung -->
      <Border CornerRadius="32" Background="{StaticResource FrostTintBrush}">
        <Border.Effect>
          <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="{StaticResource FrostColor}" Opacity="0.55" />
        </Border.Effect>
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDistracted}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <Border Height="64" CornerRadius="32" BorderThickness="1" Background="{StaticResource CapsuleBrush}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsDistracted}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FrostEdgeBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.Effect>
          <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.4" Color="Black" />
        </Border.Effect>
      </Border>
    </Grid>

    <!-- Inhalt: transparent, aber treffbar (zum Ziehen) -->
    <Border x:Name="Banner" Height="64" Padding="1" Background="Transparent" DataContext="{Binding Session}" Cursor="SizeAll"
            ToolTip="Ziehen zum Verschieben · Rechtsklick für Optionen">
      <Grid Margin="8,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Lichtring mit Zustandssymbol -->
        <Grid Width="48" Height="48" VerticalAlignment="Center">
          <views:ProgressRing Progress="{Binding Progress}" Thickness="2.5" Glow="2.5" TrackBrush="#17FFFFFF">
            <views:ProgressRing.Style>
              <Style TargetType="views:ProgressRing">
                <Setter Property="RingBrush" Value="{StaticResource GoldBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDistracted}" Value="True">
                    <Setter Property="RingBrush" Value="{StaticResource FrostBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="RingBrush" Value="{StaticResource MossBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </views:ProgressRing.Style>
          </views:ProgressRing>
          <views:LanternGlyph Width="19" Height="19" IsLit="{Binding IsLit}" />
        </Grid>

        <!-- Restzeit und Kurzstatus -->
        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding RemainingText}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Light"
                     Foreground="{StaticResource IvoryBrush}" Typography.NumeralAlignment="Tabular" />
          <TextBlock Text="{Binding ShortStatus}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDistracted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource FrostBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <!-- Frost-Chip: so lange warst du in dieser Wacht abgelenkt -->
        <Border Grid.Column="2" Height="40" CornerRadius="20" Padding="14,0" BorderThickness="1" VerticalAlignment="Center"
                ToolTip="Frost: so lange hast du dich in dieser Wacht ablenken lassen">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource GlassBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
              <Setter Property="TextElement.Foreground" Value="{StaticResource IvoryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDistracted}" Value="True">
                  <Setter Property="Background" Value="{StaticResource FrostTintBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource FrostEdgeBrush}" />
                  <Setter Property="TextElement.Foreground" Value="{StaticResource FrostBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource SnowflakeGeometry}" Stroke="{StaticResource FrostBrush}" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0"
                  VerticalAlignment="Center" />
            <TextBlock Text="{Binding FrostText}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />
            <TextBlock FontSize="12" Opacity="0.7" VerticalAlignment="Center" Margin="6,1,0,0">
              <Run Text="·" /> <Run Text="{Binding DistractionCount, Mode=OneWay}" /><Run Text="×" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Steuerung -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand">
          <Button Command="{Binding PauseResumeCommand}" ToolTip="{Binding PauseResumeLabel}"
                  AutomationProperties.Name="{Binding PauseResumeLabel}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource CapsuleButton}">
                <Setter Property="Content">
                  <Setter.Value>
                    <Path Data="{StaticResource PauseGeometry}" Style="{StaticResource FillIcon}" Width="12" Height="12" />
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Content">
                      <Setter.Value>
                        <Path Data="{StaticResource PlayGeometry}" Style="{StaticResource FillIcon}" Width="12" Height="12" />
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Style="{StaticResource CapsuleButton}" Command="{Binding AbortCommand}"
                  ToolTip="Wacht beenden" AutomationProperties.Name="Wacht beenden">
            <Path Data="{StaticResource StopGeometry}" Style="{StaticResource FillIcon}" Width="10" Height="10" />
          </Button>
          <Button Style="{StaticResource CapsuleButton}" Command="{Binding ShowChamberCommand}"
                  ToolTip="Laternenwacht öffnen" AutomationProperties.Name="Hauptfenster öffnen">
            <Path Data="{StaticResource OpenGeometry}" Style="{StaticResource LineIcon}" Width="14" Height="14" StrokeThickness="2" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
