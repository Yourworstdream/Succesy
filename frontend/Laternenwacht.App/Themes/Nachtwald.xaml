<!--
  Gestaltungssystem "Nachtwald"
  =============================
  Leitidee: ein Laternenlicht in einem verschneiten Wald bei Nacht.
  Tiefes Tannen-Schwarzgrün statt Schwarz, Glasflächen mit feiner Lichtkante,
  Champagner-Kerzenlicht als einziger warmer Akzent (Fokus, Fortschritt, Lob),
  Eisblau ausschließlich für Ablenkung. Große Ziffern im leichten Schnitt,
  Überschriften in einer modernen Serifenschrift (Sitka).

  Farbrollen
    Nacht   #08100E–#0C1714  Fensterhintergrund       Ivory  #EDE8DD  Text
    Glas    4–7 % Weiß       Flächen                  Sage   #A3AEA6  Fließtext
    Kante   9–14 % Weiß      Haarlinien               Moss   #6E7C74  Beschriftungen
    Gold    #E2C48D          Licht, Fokus, Lob        Frost  #9FD3EA  Ablenkung
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Farben ===== -->
  <Color x:Key="IvoryColor">#EDE8DD</Color>
  <Color x:Key="GoldColor">#E2C48D</Color>
  <Color x:Key="FrostColor">#9FD3EA</Color>

  <LinearGradientBrush x:Key="NightBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0D1915" Offset="0" />
    <GradientStop Color="#08100E" Offset="0.55" />
    <GradientStop Color="#0A1311" Offset="1" />
  </LinearGradientBrush>

  <!-- Warmer Lichtschimmer im Fensterhintergrund -->
  <RadialGradientBrush x:Key="AmbientGlowBrush" Center="0.32,0.7" GradientOrigin="0.32,0.7" RadiusX="0.6" RadiusY="0.7">
    <GradientStop Color="#16E2C48D" Offset="0" />
    <GradientStop Color="#00E2C48D" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="GlassBrush" Color="#0BFFFFFF" />
  <SolidColorBrush x:Key="Glass2Brush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Glass3Brush" Color="#1CFFFFFF" />
  <SolidColorBrush x:Key="EdgeBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="Edge2Brush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="PopupBrush" Color="#FA121D19" />

  <SolidColorBrush x:Key="IvoryBrush" Color="{StaticResource IvoryColor}" />
  <SolidColorBrush x:Key="SageBrush" Color="#A3AEA6" />
  <SolidColorBrush x:Key="MossBrush" Color="#6E7C74" />
  <SolidColorBrush x:Key="AwayBrush" Color="#4A5650" />

  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="GoldDeepBrush" Color="#C9A266" />
  <SolidColorBrush x:Key="GoldTintBrush" Color="#1FE2C48D" />
  <SolidColorBrush x:Key="GoldInkBrush" Color="#1B160C" />
  <LinearGradientBrush x:Key="GoldFillBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EDD6AA" Offset="0" />
    <GradientStop Color="#D2AE6E" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldBarBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#C9A266" Offset="0" />
    <GradientStop Color="#E9CF9C" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="FrostBrush" Color="{StaticResource FrostColor}" />
  <SolidColorBrush x:Key="FrostDeepBrush" Color="#5BAED3" />
  <SolidColorBrush x:Key="FrostTintBrush" Color="#249FD3EA" />
  <SolidColorBrush x:Key="FrostEdgeBrush" Color="#8C9FD3EA" />

  <SolidColorBrush x:Key="RoseBrush" Color="#D9A0A0" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#E58A8A" />
  <SolidColorBrush x:Key="ErrorTintBrush" Color="#26E58A8A" />

  <!-- Kapsel, Botschaften, Polaroid -->
  <LinearGradientBrush x:Key="CapsuleBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F8121E1A" Offset="0" />
    <GradientStop Color="#F8090F0E" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="MemePaperBrush" Color="#F3EFE6" />
  <SolidColorBrush x:Key="MemeInkBrush" Color="#2D5E78" />

  <!-- ===== Schrift ===== -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <!-- Sitka gehört seit Windows 8.1 zum System; Georgia als Rückfall -->
  <FontFamily x:Key="SerifFont">Sitka Display, Sitka Heading, Georgia</FontFamily>
  <FontFamily x:Key="SerifTextFont">Sitka Text, Sitka Small, Georgia</FontFamily>

  <!-- ===== Symbole (24×24) ===== -->
  <Geometry x:Key="FlameGeometry">M12,2.5 C14.6,5.7 18,9.1 18,13.5 A6,6 0 0 1 6,13.5 C6,11.1 7.2,9.3 8.6,7.9 C8.9,9.5 9.7,10.7 11,11.3 C10.6,8.5 11,5.6 12,2.5 Z</Geometry>
  <Geometry x:Key="SnowflakeGeometry">M12,2 L12,22 M3.3,7 L20.7,17 M3.3,17 L20.7,7 M9.5,3.8 L12,6 L14.5,3.8 M9.5,20.2 L12,18 L14.5,20.2 M4.1,10.6 L6.8,10 L6.1,7.2 M19.9,13.4 L17.2,14 L17.9,16.8 M4.1,13.4 L6.8,14 L6.1,16.8 M19.9,10.6 L17.2,10 L17.9,7.2</Geometry>
  <Geometry x:Key="PauseGeometry">M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z</Geometry>
  <Geometry x:Key="PlayGeometry">M8,5 L19,12 L8,19 Z</Geometry>
  <Geometry x:Key="StopGeometry">M8,5 L16,5 A3,3 0 0 1 19,8 L19,16 A3,3 0 0 1 16,19 L8,19 A3,3 0 0 1 5,16 L5,8 A3,3 0 0 1 8,5 Z</Geometry>
  <Geometry x:Key="OpenGeometry">M14,4 L20,4 L20,10 M20,4 L12,12 M18,14 L18,19 L5,19 L5,6 L10,6</Geometry>
  <Geometry x:Key="CheckGeometry">M6,12.5 L10,16.5 L18,7.5</Geometry>
  <Geometry x:Key="CrossGeometry">M7,7 L17,17 M17,7 L7,17</Geometry>
  <Geometry x:Key="ClockGeometry">M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 Z M12,7.5 L12,12.3 L15,14.1</Geometry>
  <Geometry x:Key="BookGeometry">M5,4.5 L16,4.5 A3,3 0 0 1 19,7.5 L19,19.5 L8,19.5 A3,3 0 0 1 5,16.5 Z M9,9 L15,9 M9,13 L13,13</Geometry>
  <Geometry x:Key="SlidersGeometry">M4,7 L14,7 M18,7 L20,7 M4,17 L8,17 M12,17 L20,17 M18,7 A2,2 0 1 1 14,7 A2,2 0 1 1 18,7 Z M12,17 A2,2 0 1 1 8,17 A2,2 0 1 1 12,17 Z</Geometry>
  <Geometry x:Key="InfoGeometry">M20.5,12 A8.5,8.5 0 1 1 3.5,12 A8.5,8.5 0 1 1 20.5,12 Z M12,11 L12,16 M12,8 L12,8.01</Geometry>
  <Geometry x:Key="PlusGeometry">M12,5 L12,19 M5,12 L19,12</Geometry>
  <Geometry x:Key="FolderGeometry">M3.5,7 A2,2 0 0 1 5.5,5 L9.5,5 L11.5,7 L18.5,7 A2,2 0 0 1 20.5,9 L20.5,17 A2,2 0 0 1 18.5,19 L5.5,19 A2,2 0 0 1 3.5,17 Z</Geometry>
  <Geometry x:Key="ChevronDownGeometry">M6,9 L12,15 L18,9</Geometry>
  <Geometry x:Key="ChevronRightGeometry">M9,6 L15,12 L9,18</Geometry>
  <Geometry x:Key="MinimizeGeometry">M5,12 L19,12</Geometry>
  <Geometry x:Key="MaximizeGeometry">M6,6 L18,6 L18,18 L6,18 Z</Geometry>

  <Style x:Key="LineIcon" TargetType="Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="FillIcon" TargetType="Path">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Typografie ===== -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
    <Setter Property="FontSize" Value="23" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Kleine Großbuchstaben-Beschriftung (Text in Großbuchstaben schreiben) -->
  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="Quote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SerifTextFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#8F9A93" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- ===== Flächen ===== -->
  <!-- Glaskarte: leicht aufgehellte Fläche mit feiner Lichtkante -->
  <Style x:Key="Glass" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="26" />
  </Style>

  <Style x:Key="SmallGlass" TargetType="Border" BasedOn="{StaticResource Glass}">
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <!-- ===== Schaltflächen ===== -->
  <!-- Tag = Farbe der Hover-Schicht -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" />
            <Border x:Name="Hover" Background="{TemplateBinding Tag}" CornerRadius="22" Opacity="0" />
            <Border x:Name="FocusRing" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" CornerRadius="24" Opacity="0" Margin="-3" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Hauptaktion: Champagner mit sanftem Lichtschein -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource GoldFillBrush}" />
    <Setter Property="Foreground" Value="{StaticResource GoldInkBrush}" />
    <Setter Property="Tag" Value="#33FFFFFF" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="{StaticResource GoldColor}" Opacity="0.22" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Glass2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Tag" Value="#14FFFFFF" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="Tag" Value="#0FFFFFFF" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
    <Setter Property="Tag" Value="{StaticResource ErrorTintBrush}" />
  </Style>

  <!-- Schnellstart-Kapsel innerhalb einer Glasspur -->
  <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="Tag" Value="{StaticResource GoldTintBrush}" />
  </Style>

  <!-- Runde Symbolschaltfläche in der Kapsel -->
  <Style x:Key="CapsuleButton" TargetType="Button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Circle" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="20">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circle" Property="Background" Value="{StaticResource Glass3Brush}" />
              <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Circle" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Titelleisten-Schaltflächen (eigene Fensterleiste) -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
    <Setter Property="Tag" Value="{StaticResource Glass2Brush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Eingaben ===== -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Background" Value="#33000000" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Kontrollkästchen als Schalter -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="{StaticResource Glass3Brush}"
                    BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource SageBrush}" HorizontalAlignment="Left" Margin="3,0" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource GoldFillBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource GoldInkBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Ring" Width="20" Height="20" Fill="#33000000" Stroke="{StaticResource Edge2Brush}"
                     StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,1,0,0" />
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GoldBrush}" />
              <Setter TargetName="Ring" Property="StrokeThickness" Value="6" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dunkle Auswahlliste -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="#33000000" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="12">
            <Path Data="{StaticResource ChevronDownGeometry}" Stroke="{StaticResource SageBrush}" StrokeThickness="1.8" Width="12" Height="12"
                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="14,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                      CornerRadius="12" Padding="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Padding="12,9" CornerRadius="8" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass2Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schmale Bildlaufleisten -->
  <Style x:Key="SlimThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="#26FFFFFF" Margin="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource SlimThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                  CornerRadius="8" Padding="10,6" MaxWidth="360">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dunkles Kontextmenü (Rechtsklick auf die Fokusleiste) -->
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                  CornerRadius="14" Padding="6">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Background="Transparent" MinWidth="260">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="IconHost" ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <Path x:Name="Check" Data="{StaticResource CheckGeometry}" Stroke="{StaticResource GoldBrush}" StrokeThickness="2"
                    Width="12" Height="10" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <Path x:Name="Arrow" Grid.Column="2" Data="{StaticResource ChevronRightGeometry}" Stroke="{StaticResource SageBrush}"
                    StrokeThickness="1.8" Width="8" Height="12" Stretch="Uniform" Margin="14,0,0,0" Visibility="Collapsed"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="10" VerticalOffset="-8" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                        CornerRadius="14" Padding="6">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="8,5" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schmaler Fortschrittsbalken -->
  <Style x:Key="SlimProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoldBarBrush}" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
</ResourceDictionary>
