    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="38" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrightBrush}" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="#C9BFA6" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrightBrush}" />
  </Style>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontSize" Value="16.5" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Kleine Versal-Beschriftung (Cinzel kennt nur Großbuchstaben bzw. Kapitälchen) -->
  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MossBrush}" />
  </Style>

  <Style x:Key="Metric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrightBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="Quote" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="#E3D9BF" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!--
    Erzähltext über einem Szenenbild (Station, "Anders als Edmund …"): helle Kursive mit weichem Schatten.
    Der Schatten ist ein Effekt; der Text wird deshalb zwischengespeichert (RenderCache) und nur neu gezeichnet,
    wenn er sich ändert (selten) – nicht, wenn daneben im Sekundentakt die Restzeit springt.
  -->
  <Style x:Key="Narration" TargetType="TextBlock">
    <Setter Property="views:RenderCache.IsEnabled" Value="True" />
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="#EDE3CA" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.8" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Typografie (Tinte auf Pergament) ===== -->
  <Style x:Key="InkTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="27" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <Style x:Key="InkOverline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
  </Style>

  <Style x:Key="InkMetric" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="InkBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontSize" Value="17.5" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ===== Flächen ===== -->
  <!-- Glaskarte der Nachtseiten: Nachtblau mit feiner Goldkante -->
  <Style x:Key="Glass" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NightPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="26" />
  </Style>

  <Style x:Key="SmallGlass" TargetType="Border" BasedOn="{StaticResource Glass}">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <!-- Dunkle Glasfläche als ContentControl (Siegel, Kennzahlen, Rabenbote auf Nacht) -->
  <Style x:Key="NightPanel" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Padding" Value="24,20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{StaticResource NightPanelBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Pergamentkarte: verlaufendes Pergament mit Goldrand, Innenlinie (9 px eingerückt) und vier Eckzierden.
    Der große Schatten liegt in einer eigenen, zwischengespeicherten Ebene – er wird nur bei Größenänderung neu gezeichnet,
    nicht wenn sich im Sekundentakt Zahlen auf der Karte ändern. Vordergrund ist Tinte; Fließtext in EB Garamond.
  -->
  <Style x:Key="ParchmentCard" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource GaramondFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Padding" Value="34,38,34,34" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Grid views:RenderCache.IsEnabled="True" IsHitTestVisible="False">
              <Border Background="{StaticResource ParchmentEdgeBrush}" CornerRadius="6">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="56" ShadowDepth="22" Direction="270" Color="Black" Opacity="0.5" />
                </Border.Effect>
              </Border>
              <Border Background="{StaticResource ParchmentBrush}" BorderBrush="{StaticResource ParchmentEdgeBrush}"
                      BorderThickness="1" CornerRadius="6" />
              <Border Margin="9" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1" CornerRadius="3" />
              <Path Data="{StaticResource CornerFlourishGeometry}" Stroke="{StaticResource InkGoldBrush}" StrokeThickness="1.2"
                    Stretch="None" Width="28" Height="28" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top" />
              <Path Data="{StaticResource CornerFlourishGeometry}" Stroke="{StaticResource InkGoldBrush}" StrokeThickness="1.2"
                    Stretch="None" Width="28" Height="28" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
              </Path>
              <Path Data="{StaticResource CornerFlourishGeometry}" Stroke="{StaticResource InkGoldBrush}" StrokeThickness="1.2"
                    Stretch="None" Width="28" Height="28" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleY="-1" />
                </Path.RenderTransform>
              </Path>
              <Path Data="{StaticResource CornerFlourishGeometry}" Stroke="{StaticResource InkGoldBrush}" StrokeThickness="1.2"
                    Stretch="None" Width="28" Height="28" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <ScaleTransform ScaleX="-1" ScaleY="-1" />
                </Path.RenderTransform>
              </Path>
            </Grid>
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Schaltflächen ===== -->
  <!-- Tag = Farbe der Hover-Schicht; die Form ist immer eine Pille -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Style.Resources>
      <!-- Schirmt das globale TextBlock-Format ab: Text in der Schaltfläche erbt deren Schrift (Cinzel) -->
      <Style TargetType="TextBlock" />
    </Style.Resources>
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" />
            <Border x:Name="Hover" Background="{TemplateBinding Tag}" CornerRadius="999" Opacity="0" />
            <Border x:Name="FocusRing" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1.5" CornerRadius="999" Opacity="0" Margin="-4" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Hauptaktion: Laternengold mit warmem Schein ("Laterne entzünden") -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource GoldFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource InkGoldBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoldInkBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Tag">
      <Setter.Value>
        <SolidColorBrush Color="#33FFF4D6" />
      </Setter.Value>
    </Setter>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#A0681E" Opacity="0.35" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Tag" Value="{StaticResource GoldTintBrush}" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="Tag" Value="{StaticResource GlassBrush}" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
    <Setter Property="Tag" Value="{StaticResource ErrorTintBrush}" />
  </Style>

  <!-- Tinte auf Pergament: umrandete Pille ("Rasten", "Weiterziehen") -->
  <Style x:Key="InkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Tag" Value="{StaticResource InkTintBrush}" />
  </Style>

  <!-- Tinte auf Pergament, rot und ohne Rand ("Wacht beenden") -->
  <Style x:Key="InkDangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkRedBrush}" />
    <Setter Property="Tag">
      <Setter.Value>
        <SolidColorBrush Color="#149E2B1F" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schnellstart-Kapsel innerhalb einer Glasspur -->
  <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SageBrush}" />
    <Setter Property="Tag" Value="{StaticResource GoldTintBrush}" />
  </Style>

  <!-- Runde Symbolschaltfläche in der Kapsel -->
  <Style x:Key="CapsuleButton" TargetType="Button">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="#E8DCBC" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Circle" Background="#0AFFFFFF" BorderBrush="#33F1E6CC"
                  BorderThickness="1" CornerRadius="20">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Circle" Property="Background" Value="{StaticResource Glass3Brush}" />
              <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Circle" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Titelleisten-Schaltflächen (eigene Fensterleiste) -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Foreground" Value="#B3AC98" />
    <Setter Property="Tag" Value="{StaticResource Glass2Brush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Rundes Wachssiegel als Auswahl (z. B. Dauer 15 / 25 / 50 / 90): offen = Tintenring auf Pergament,
    gewählt = rotes Wachs mit gewelltem Rand und hellem Innenring. Inhalt = Beschriftung (Cinzel).
  -->
  <Style x:Key="SealToggle" TargetType="RadioButton">
    <Style.Resources>
      <!-- Schirmt das globale TextBlock-Format ab: Text in der Schaltfläche erbt deren Schrift (Cinzel) -->
      <Style TargetType="TextBlock" />
    </Style.Resources>
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="58" />
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform />
            </Grid.RenderTransform>
            <Path x:Name="Wax" Data="{StaticResource WaxSealGeometry}" Stretch="Fill" Fill="{StaticResource NarniaRedBrush}"
                  Margin="-3" Visibility="Hidden" />
            <Ellipse x:Name="Ring" Stroke="#8C2A1E14" StrokeThickness="1.5" Fill="Transparent" />
            <Ellipse x:Name="Inner" Margin="8" Stroke="#1FFFFFFF" StrokeThickness="1.5" Visibility="Hidden" />
            <Ellipse x:Name="Hover" Fill="{StaticResource InkTintBrush}" Opacity="0" />
            <Ellipse x:Name="FocusRing" Stroke="{StaticResource InkGoldBrush}" StrokeThickness="1.5" Margin="-6" Opacity="0" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Wax" Property="Visibility" Value="Visible" />
              <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ring" Property="Fill" Value="{StaticResource SealLightBrush}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SealDarkBrush}" />
              <Setter TargetName="Ring" Property="Margin" Value="4" />
              <Setter TargetName="Hover" Property="Opacity" Value="0" />
              <Setter Property="Foreground" Value="#FBF1DC" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Buchrücken im Regal (Wahl des Bandes): Leder in der Farbe aus Tag (Brush), goldene Doppellinien oben und unten,
    Inhalt = Bandnummer. Gewählt = 12 px angehoben mit Goldring. Höhe über Height (Standard 88).
  -->
  <Style x:Key="BookSpine" TargetType="RadioButton">
    <Style.Resources>
      <!-- Schirmt das globale TextBlock-Format ab: Text in der Schaltfläche erbt deren Schrift (Cinzel) -->
      <Style TargetType="TextBlock" />
    </Style.Resources>
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="88" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Tag">
      <Setter.Value>
        <SolidColorBrush Color="#2E4A3A" />
      </Setter.Value>
    </Setter>
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#F0CF8A" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <Grid.RenderTransform>
              <TranslateTransform />
            </Grid.RenderTransform>
            <Border x:Name="Ring" Margin="-2" CornerRadius="5,5,3,3" BorderBrush="{StaticResource GoldBrush}" BorderThickness="2"
                    Visibility="Hidden" />
            <Border x:Name="Leather" CornerRadius="3,3,1,1" Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
              <Grid>
                <!-- Lichtkante links, Schattenkante rechts -->
                <Border Width="3" HorizontalAlignment="Left" Background="#14FFFFFF" CornerRadius="3,0,0,1" />
                <Border Width="4" HorizontalAlignment="Right" Background="#40000000" CornerRadius="0,3,1,0" />
                <Border Width="26" Height="4" VerticalAlignment="Top" Margin="0,10,0,0" BorderBrush="#D9B26A" BorderThickness="0,1" />
                <Border Width="26" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,10" BorderBrush="#D9B26A" BorderThickness="0,1" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
            </Border>
            <Border x:Name="Hover" CornerRadius="3,3,1,1" Background="#14FFFFFF" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="-12" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource InkGoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Eingaben ===== -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Background" Value="#40000000" />
    <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CaretBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Eingabefeld auf Pergament (z. B. "Eigene Dauer") -->
  <Style x:Key="InkTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontFamily" Value="{StaticResource CinzelFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background" Value="#8CFFFAEE" />
    <Setter Property="BorderBrush" Value="#8C6B5434" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource GoldDeepBrush}" />
  </Style>

  <!-- Kontrollkästchen als Schalter -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="{StaticResource Glass3Brush}"
                    BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource SageBrush}" HorizontalAlignment="Left" Margin="3,0" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource GoldFillBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource InkGoldBrush}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource GoldInkBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Ring" Width="20" Height="20" Fill="#33000000" Stroke="{StaticResource Edge2Brush}"
                     StrokeThickness="1.5" VerticalAlignment="Top" Margin="0,2,0,0" />
            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GoldBrush}" />
              <Setter TargetName="Ring" Property="StrokeThickness" Value="6" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dunkle Auswahlliste -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="#40000000" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="10">
            <Path Data="{StaticResource ChevronDownGeometry}" Stroke="{StaticResource SageBrush}" StrokeThickness="1.8" Width="12" Height="12"
                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Edge2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="14,0,40,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                      CornerRadius="10" Padding="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Padding="12,9" CornerRadius="8" Background="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass2Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schmale Bildlaufleisten -->
  <Style x:Key="SlimThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="#40C9A056" Margin="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource SlimThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                  CornerRadius="8" Padding="10,6" MaxWidth="360">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dunkles Kontextmenü (Rechtsklick auf die Fokusleiste) -->
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                  CornerRadius="12" Padding="6">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Background="Transparent" MinWidth="260">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="IconHost" ContentSource="Icon" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <Path x:Name="Check" Data="{StaticResource CheckGeometry}" Stroke="{StaticResource GoldBrush}" StrokeThickness="2"
                    Width="12" Height="10" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <Path x:Name="Arrow" Grid.Column="2" Data="{StaticResource ChevronRightGeometry}" Stroke="{StaticResource SageBrush}"
                    StrokeThickness="1.8" Width="8" Height="12" Stretch="Uniform" Margin="14,0,0,0" Visibility="Collapsed"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="10" VerticalOffset="-8" AllowsTransparency="True"
                     Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource Edge2Brush}" BorderThickness="1"
                        CornerRadius="12" Padding="6">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Glass2Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{StaticResource EdgeBrush}" Margin="8,5" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schmaler Fortschrittsbalken -->
  <Style x:Key="SlimProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoldBarBrush}" />
    <Setter Property="Background" Value="#1FF1E6CC" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schmaler Fortschrittsbalken auf Pergament ("Nächstes Ziel") -->
  <Style x:Key="InkProgress" TargetType="ProgressBar" BasedOn="{StaticResource SlimProgress}">
    <Setter Property="Foreground" Value="{StaticResource GoldDeepBrush}" />
    <Setter Property="Background" Value="#336B5434" />
  </Style>

  <!--
    ===== Szenenrahmen =====
    Goldgerahmtes Szenenbild (Bogen oben oder abgerundet), darüber die Stimmungsschleier für Frost, Rast und Abwesenheit
    und zuletzt der Inhalt. Form, Rahmen und Schatten berechnet SceneFrame bei Größenänderung (siehe SceneFrame.cs).
    Der Schatten liegt in einer zwischengespeicherten Ebene; die Schleier sind feste Pinsel, nur ihre Deckkraft folgt den Werten.
  -->
  <RadialGradientBrush x:Key="SceneFrostVeilBrush" Center="0.5,0.52" GradientOrigin="0.5,0.52" RadiusX="0.72" RadiusY="0.72">
    <GradientStop Color="#00AAD6EC" Offset="0" />
    <GradientStop Color="#00AAD6EC" Offset="0.35" />
    <GradientStop Color="#3DB4DCF0" Offset="0.78" />
    <GradientStop Color="#8CD6EEFA" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="SceneWarmVeilBrush" Center="0.5,1" GradientOrigin="0.5,1" RadiusX="0.8" RadiusY="0.7">
    <GradientStop Color="#38E08A4A" Offset="0" />
    <GradientStop Color="#1AE08A4A" Offset="0.45" />
    <GradientStop Color="#00E08A4A" Offset="0.75" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="SceneDimVeilBrush" Color="#4704080B" />
  <LinearGradientBrush x:Key="SceneBottomShadeBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0004080B" Offset="0" />
    <GradientStop Color="#8C04080B" Offset="0.7" />
    <GradientStop Color="#B304080B" Offset="1" />
  </LinearGradientBrush>

  <Style TargetType="views:SceneFrame">
    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="views:SceneFrame">
          <Grid>
            <!-- Schatten, dunkle Fuge und äußerer Ring: einmal gezeichnet, dann zwischengespeichert -->
            <Grid views:RenderCache.IsEnabled="True" IsHitTestVisible="False">
              <Path Data="{TemplateBinding OuterRingGeometry}" Fill="#081116">
                <Path.Effect>
                  <DropShadowEffect BlurRadius="70" ShadowDepth="30" Direction="270" Color="Black" Opacity="0.55" />
                </Path.Effect>
              </Path>
              <Path x:Name="PART_GoldRing" Data="{TemplateBinding OuterRingGeometry}" Stroke="#73B8904A" StrokeThickness="1" />
            </Grid>
            <!-- Eisring bei Ablenkung (Deckkraft = FrostLevel) -->
            <Path x:Name="PART_IceRing" Data="{TemplateBinding OuterRingGeometry}" Stroke="#809FD0EA" StrokeThickness="1"
                  Opacity="{TemplateBinding FrostLevel}" IsHitTestVisible="False" />

            <Grid Clip="{TemplateBinding ShapeGeometry}" Background="#0A141A">
              <Image Source="{TemplateBinding Source}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality" />
              <Rectangle Fill="{StaticResource SceneFrostVeilBrush}" Opacity="{TemplateBinding FrostLevel}" IsHitTestVisible="False" />
              <Rectangle Fill="{StaticResource SceneWarmVeilBrush}" Opacity="{TemplateBinding WarmLevel}" IsHitTestVisible="False" />
              <Rectangle Fill="{StaticResource SceneDimVeilBrush}" Opacity="{TemplateBinding DimLevel}" IsHitTestVisible="False" />
              <!-- Lesbarkeit für Text im unteren Bilddrittel, nur wenn es Inhalt gibt -->
              <Rectangle x:Name="BottomShade" Fill="{StaticResource SceneBottomShadeBrush}" VerticalAlignment="Bottom"
                         Height="{TemplateBinding ShadeHeight}" IsHitTestVisible="False" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>

            <!-- Goldener Innenrahmen -->
            <Path Data="{TemplateBinding FrameGeometry}" Stroke="{StaticResource FrameGoldBrush}" StrokeThickness="2" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="True">
              <Setter TargetName="BottomShade" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
</ResourceDictionary>
