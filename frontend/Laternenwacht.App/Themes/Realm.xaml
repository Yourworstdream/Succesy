<!--
  "Das Reich hinter dem Schrank" – Gestaltungssystem der Laternenwacht.
  Farbwelt: Winternacht (Tiefblau), Laternengold, Pergament, Frost und das Karmesin eines Löwenbanners.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Farben ===== -->
  <Color x:Key="NightColor">#0E1A2B</Color>
  <Color x:Key="NightDeepColor">#08111D</Color>
  <Color x:Key="NightLightColor">#1C2E48</Color>
  <Color x:Key="GoldColor">#E8B84A</Color>
  <Color x:Key="GoldDimColor">#9C7A2E</Color>
  <Color x:Key="ParchmentColor">#F3E9D2</Color>
  <Color x:Key="ParchmentDarkColor">#D9C9A3</Color>
  <Color x:Key="InkColor">#2B2118</Color>
  <Color x:Key="FrostColor">#A9D6E5</Color>
  <Color x:Key="FrostWhiteColor">#EAF6FB</Color>
  <Color x:Key="CrimsonColor">#8B1E2D</Color>
  <Color x:Key="SpringColor">#6E9E55</Color>

  <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}" />
  <SolidColorBrush x:Key="NightLightBrush" Color="{StaticResource NightLightColor}" />
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="GoldDimBrush" Color="{StaticResource GoldDimColor}" />
  <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource ParchmentColor}" />
  <SolidColorBrush x:Key="ParchmentDarkBrush" Color="{StaticResource ParchmentDarkColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="FrostBrush" Color="{StaticResource FrostColor}" />
  <SolidColorBrush x:Key="FrostWhiteBrush" Color="{StaticResource FrostWhiteColor}" />
  <SolidColorBrush x:Key="CrimsonBrush" Color="{StaticResource CrimsonColor}" />
  <SolidColorBrush x:Key="SpringBrush" Color="{StaticResource SpringColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#B8C4D6" />

  <LinearGradientBrush x:Key="NightSkyBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{StaticResource NightDeepColor}" Offset="0" />
    <GradientStop Color="{StaticResource NightColor}" Offset="0.55" />
    <GradientStop Color="{StaticResource NightLightColor}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ParchmentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F7EFDC" Offset="0" />
    <GradientStop Color="#EADBB8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F4D58A" Offset="0" />
    <GradientStop Color="{StaticResource GoldColor}" Offset="0.5" />
    <GradientStop Color="#B8892C" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="FrostGradientBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00EAF6FB" Offset="0" />
    <GradientStop Color="#CCEAF6FB" Offset="0.6" />
    <GradientStop Color="#FFFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- ===== Schrift ===== -->
  <!-- Palatino Linotype gehört zum Lieferumfang von Windows; Georgia dient als Rückfall. -->
  <FontFamily x:Key="RealmFont">Palatino Linotype, Book Antiqua, Georgia, serif</FontFamily>
  <FontFamily x:Key="NumberFont">Palatino Linotype, Georgia</FontFamily>

  <!-- ===== Vektor-Glyphen (24×24) ===== -->
  <Geometry x:Key="SnowflakeGeometry">M12,1 L12,23 M2.5,6.5 L21.5,17.5 M2.5,17.5 L21.5,6.5 M9,3 L12,5.5 L15,3 M9,21 L12,18.5 L15,21 M3.2,10.3 L6.4,9.5 L5.3,6.2 M20.8,13.7 L17.6,14.5 L18.7,17.8 M3.2,13.7 L6.4,14.5 L5.3,17.8 M20.8,10.3 L17.6,9.5 L18.7,6.2</Geometry>
  <Geometry x:Key="ShieldGeometry">M12,1.5 L20.5,4.8 L20.5,11 C20.5,16.2 16.9,20.3 12,22.5 C7.1,20.3 3.5,16.2 3.5,11 L3.5,4.8 Z</Geometry>
  <Geometry x:Key="CheckGeometry">M7.5,12 L10.8,15.2 L16.8,8.8</Geometry>
  <Geometry x:Key="CrackGeometry">M12,4 L10,9 L13.5,11 L10.5,15.5 L12.5,20</Geometry>
  <Geometry x:Key="PauseGeometry">M7,5 L10,5 L10,19 L7,19 Z M14,5 L17,5 L17,19 L14,19 Z</Geometry>
  <Geometry x:Key="PlayGeometry">M8,5 L19,12 L8,19 Z</Geometry>
  <Geometry x:Key="StopGeometry">M6.5,6.5 L17.5,6.5 L17.5,17.5 L6.5,17.5 Z</Geometry>
  <Geometry x:Key="DoorGeometry">M6,2.5 L18,2.5 L18,21.5 L6,21.5 Z M12,2.5 L12,21.5 M10,11 L10,13 M14,11 L14,13</Geometry>
  <Geometry x:Key="SunGeometry">M12,7 A5,5 0 1 1 11.99,7 Z M12,1 L12,4 M12,20 L12,23 M1,12 L4,12 M20,12 L23,12 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2</Geometry>

  <!-- ===== Grundstile ===== -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="BodyInk" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Proverb" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style x:Key="Ornament" TargetType="TextBlock">
    <Setter Property="Text" Value="✦ ─── ❦ ─── ✦" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource GoldDimBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <!-- Pergamentkarte -->
  <Style x:Key="ParchmentCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ParchmentGradientBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Schaltflächen -->
  <Style x:Key="RealmButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="{StaticResource GoldColor}" Opacity="0.8" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderThickness" Value="2.5" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource RealmButtonBase}">
    <Setter Property="Background" Value="{StaticResource GoldGradientBrush}" />
    <Setter Property="BorderBrush" Value="#7A5A1C" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="RuneButton" TargetType="Button" BasedOn="{StaticResource RealmButtonBase}">
    <Setter Property="Background" Value="#22E8B84A" />
    <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
    <Setter Property="BorderThickness" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
  </Style>

  <Style x:Key="InkButton" TargetType="Button" BasedOn="{StaticResource RealmButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>

  <!-- Runde Symbolschaltfläche für die Fokusleiste -->
  <Style x:Key="GlyphButton" TargetType="Button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Ring" Background="#1AE8B84A" BorderBrush="{StaticResource GoldDimBrush}" BorderThickness="1.2" CornerRadius="17">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Background" Value="#44E8B84A" />
              <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Gefüllte Glyphe in einer Schaltfläche -->
  <Style x:Key="GlyphFill" TargetType="Path">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  </Style>

  <!-- Gezeichnete (Linien-)Glyphe in einer Schaltfläche -->
  <Style x:Key="GlyphStroke" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  </Style>

  <!-- Eingabefelder -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#FFFBF3" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource GoldBrush}" />
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Margin" Value="0,3" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Margin" Value="0,3" />
  </Style>

  <!-- Reiter als goldene Banner -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Padding="18,8" Margin="0,0,6,0" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
              <Setter TargetName="Tab" Property="Background" Value="#18E8B84A" />
              <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource ParchmentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource RealmFont}" />
    <Setter Property="Background" Value="{StaticResource ParchmentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GoldDimBrush}" />
  </Style>

  <!-- Frostiger Fortschrittsbalken: Gold = vergangene Zeit -->
  <Style x:Key="QuestProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource GoldGradientBrush}" />
    <Setter Property="Background" Value="#33FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
</ResourceDictionary>
