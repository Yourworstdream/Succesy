root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xml,xaml,csproj,props,json,yml,pubxml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_style_readonly_field = true:warning
# Deutsche UI-Texte sind bewusst im Code (keine Lokalisierung im Projektumfang)
dotnet_diagnostic.CA1303.severity = none
# ConfigureAwait ist in einer Desktop-App nicht erforderlich
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# Testmethoden mit Unterstrichen sind gewollt
dotnet_diagnostic.CA1707.severity = none
